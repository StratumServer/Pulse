        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Packets per second by channel",
      "id": 19,
      "description": "Packet rate over the same engine window. Needs the engine probe.",
      "gridPos": {
        "x": 6,
        "y": 42,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
