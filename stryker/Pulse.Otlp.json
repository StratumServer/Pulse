{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/src/Stryker.Core/Stryker.Core/Schemas/stryker-config.json",
  "stryker-config": {
    "solution": "Pulse.slnx",
    "project": "Pulse.Otlp.csproj",
    "test-projects": [
      "Pulse.Otlp.Tests.csproj"
    ],
    "mutate": [
      "!**/PulseOtlpModSystem.cs"
    ],
    "configuration": "Release",
    "reporters": [
      "progress",
      "json"
    ],
    "thresholds": {
      "high": 80,
      "low": 65,
      "break": 65
    }
  }
}
