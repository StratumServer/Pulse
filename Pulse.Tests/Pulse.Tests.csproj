<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(FrameworkVersion)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plain reference: these tests exercise the aggregator, the exposition writer and the log
         classifier in process, with no server and no mod loader, so the ordinary assembly identity
         applies. The Atlas scenarios live in Pulse.Scenarios, which stages the mod instead. -->
    <ProjectReference Include="..\Pulse\Pulse.csproj" />

    <!-- Private=true: the classifier takes an EnumLogType, so the game dll has to sit next to the
         test assembly. No server is booted here; only the enum is loaded. -->
    <Reference Include="VintagestoryAPI" HintPath="$(VINTAGE_STORY)/VintagestoryAPI.dll" Private="true" />

    <!-- The engine's own ChatCommandApi and ChatCommandImpl, both concrete classes in
         VintagestoryLib rather than VintagestoryAPI: what PulseModSystemClashTests registers a
         name clash against, so the clash is the engine's own exception, not a stand-in for it. -->
    <Reference Include="VintagestoryLib" HintPath="$(VINTAGE_STORY)/VintagestoryLib.dll" Private="true" />

    <!-- Survival, which the game ships in Mods/ beside the API. ModOwnersTests names its
         EntityBehaviorPassivePhysicsMultiBox, which inherits the engine's passive physics name and is
         the one pair of classes vanilla has that a name is shared across two owners. Only the type is
         named: no Survival code runs. -->
    <Reference Include="VSSurvivalMod" HintPath="$(VINTAGE_STORY)/Mods/VSSurvivalMod.dll" Private="true" />
  </ItemGroup>
</Project>
