<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(FrameworkVersion)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plain reference: these tests exercise the aggregator and the exposition writer in
         process, with no server and no mod loader, so the ordinary assembly identity applies.
         The Atlas scenarios live in Pulse.Scenarios, which stages the mod instead. -->
    <ProjectReference Include="..\Pulse\Pulse.csproj" />
  </ItemGroup>
</Project>
