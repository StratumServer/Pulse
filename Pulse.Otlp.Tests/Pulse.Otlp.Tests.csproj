<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(FrameworkVersion)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pulse.Otlp\Pulse.Otlp.csproj" />

    <!-- Private=true: PulseOtlpModSystem.TryStoreDefaults is reached directly (it is internal,
         not reflected into, like ExportFailureLog), and PulseOtlpModSystem extends ModSystem, so
         the game dll has to sit next to the test assembly for that type to resolve. No server is
         booted here; the game API is loaded, never called. -->
    <Reference Include="VintagestoryAPI" HintPath="$(VINTAGE_STORY)/VintagestoryAPI.dll" Private="true" />
  </ItemGroup>
</Project>
