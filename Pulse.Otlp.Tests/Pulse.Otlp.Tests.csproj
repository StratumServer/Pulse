<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(FrameworkVersion)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plain reference: these tests exercise the config translation in process, with no server,
         no mod loader and no exporter thread. Nothing here touches the game API, so unlike
         Pulse.Tests this project needs no VintagestoryAPI.dll beside it. -->
    <ProjectReference Include="..\Pulse.Otlp\Pulse.Otlp.csproj" />
  </ItemGroup>
</Project>
